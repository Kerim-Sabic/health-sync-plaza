{
  "name": "Kinra",
  "short_name": "Kinra",
  "description": "Training, recovery and coaching in one place.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0c0d10",
  "theme_color": "#0c0d10",
  "categories": ["health", "fitness", "lifestyle"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Start a session", "url": "/app?start=session", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Messages", "url": "/app/messages", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
